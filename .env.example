# =====================================================================
# Elektron Net Faucet -- Docker environment
#
# Everything below is a FIRST-INSTALL-ONLY seed. bin/docker-install.php
# runs once, on the very first container start (before .installed exists
# in ./data/config/), and writes these values into the database. Once
# installed, editing this file and restarting the container has NO EFFECT
# -- use the Admin Panel (https://.../admin.php) to change any of these
# values afterward. Nothing here is read live.
# =====================================================================

FAUCET_PORT=8080

# ---- Database (also provisions the `db` container) ----
FAUCET_DB_HOST=db
FAUCET_DB_PORT=3306
FAUCET_DB_NAME=elek_faucet
FAUCET_DB_USER=elek_faucet
FAUCET_DB_PASS=CHANGE_ME
FAUCET_DB_ROOT_PASS=CHANGE_ME_ROOT

# ---- Encryption key (secrets at rest) ----
# Optional: auto-generated and persisted into data/config/config.php on
# first boot if left unset. Set it explicitly only if you need a
# reproducible/backed-up key: php -r "echo bin2hex(random_bytes(32));"
#FAUCET_APP_KEY=

# ---- Admin account (created once, on first install only) ----
FAUCET_ADMIN_USER=admin
FAUCET_ADMIN_PASS=CHANGE_ME_MIN_10_CHARS

# ---- elektron-net node RPC ----
# Node running natively on the SAME Windows host as Docker Desktop:
FAUCET_RPC_HOST=http://host.docker.internal
# Node on a different LAN machine instead:
#FAUCET_RPC_HOST=http://192.168.1.100
FAUCET_RPC_PORT=8332
FAUCET_RPC_USER=
FAUCET_RPC_PASS=

# Required only if your node has more than one wallet loaded ("Multiple
# wallets are loaded. Please select which wallet to use by requesting the
# RPC through the /wallet/<walletname> URI path." otherwise). Set this to
# the exact wallet name as shown by `elektron-cli listwallets`. Leave unset
# for a node with only one (default) wallet.
#FAUCET_WALLET_NAME=

FAUCET_WALLET_PASS=
FAUCET_RPC_TLS_VERIFY=1
# Hostname (SAN) check for the RPC TLS cert -- leave 0 (default) if you use
# a wildcard certificate via one of the "Running the node on a separate
# host" patterns in the README. Certificate chain validation still applies
# as long as FAUCET_RPC_TLS_VERIFY=1.
FAUCET_RPC_TLS_VERIFY_HOST=0

# ---- hCaptcha (strongly recommended -- bots will find your faucet) ----
FAUCET_HCAPTCHA_SITE=
FAUCET_HCAPTCHA_SECRET=

# ---- Faucet business settings ----
FAUCET_TITLE=Elektron Net Faucet
FAUCET_MESSAGE=Claim some free ELEK!
FAUCET_AMOUNT_ELEK=0.001
FAUCET_DAILY_BUDGET=1
FAUCET_HOURLY_BUDGET=0.1
FAUCET_PER_ADDR_COOLDOWN_H=24
FAUCET_PER_IP_COOLDOWN_H=1
FAUCET_SENDER_ADDR=
FAUCET_EXPLORER_URL=
FAUCET_DEFAULT_LANG=en
